#!/bin/sh
# Agent pipeline trigger (PIPELINE.md, "Triggers"): when the owner pushes to an agent or Dependabot
# PR's branch, start the local reviewer on it once the push lands. Installed by
# install-triggers.ps1 (core.hooksPath). Never blocks the push.

# The agents' own pushes (their checkouts, or a run trigger.ps1 started) don't trigger anything.
[ -n "$LOGTELLIGENT_AGENT" ] && exit 0
top=$(git rev-parse --show-toplevel)
case "$top" in *Logtelligent-reviewer* | *Logtelligent-builder*) exit 0 ;; esac
script="$top/.github/agent/trigger.ps1"
[ -f "$script" ] || exit 0

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a deleted branch
  case "$remote_ref" in
    refs/heads/agent/issue-* | refs/heads/dependabot/*)
      branch=${remote_ref#refs/heads/}
      # Start-Process detaches it, so the push finishes now and the trigger waits for it to land.
      powershell.exe -NoProfile -Command "Start-Process powershell.exe -WindowStyle Hidden -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','$(cygpath -w "$script")','-Agent','review','-Branch','$branch','-Sha','$local_sha'" >/dev/null 2>&1
      ;;
  esac
done
exit 0
